# ─── Backend ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/fii_insights.db
# Produção (Neon) — o driver +psycopg é injetado automaticamente se você usar postgresql://
# DATABASE_URL=postgresql+psycopg://usuario:senha@host.neon.tech/dbname?sslmode=require
BRAPI_TOKEN=seu_token_aqui   # Obtenha gratuitamente em: https://brapi.dev
CORS_ORIGINS=http://localhost:5173   # Múltiplas origens: separe por vírgula
LOG_LEVEL=INFO
# development | production. Em production o boot é RECUSADO se AUTH_SECRET for vazio
# ou igual ao default inseguro abaixo (RNF-02′). No Render, defina ENVIRONMENT=production.
ENVIRONMENT=development
# Segredo de assinatura do JWT. Em produção defina um valor forte e único (Render, sync:false):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_SECRET=dev-insecure-secret-troque-em-producao-0123456789
# Assistente IA (RF-38) — chave grátis em https://aistudio.google.com (vazio => assistente 503)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Frontend (copiar para frontend/.env.local) ─────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
