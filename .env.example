# ─── Backend ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/fii_insights.db
# Produção (Neon) — o driver +psycopg é injetado automaticamente se você usar postgresql://
# DATABASE_URL=postgresql+psycopg://usuario:senha@host.neon.tech/dbname?sslmode=require
BRAPI_TOKEN=seu_token_aqui   # Obtenha gratuitamente em: https://brapi.dev
CORS_ORIGINS=http://localhost:5173   # Múltiplas origens: separe por vírgula
LOG_LEVEL=INFO

# ─── Frontend (copiar para frontend/.env.local) ─────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
